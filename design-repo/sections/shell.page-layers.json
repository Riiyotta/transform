        "required": [
          "assetRole",
          "assetRef"
        ],
        "properties": {
          "assetRole": {
            "allOf": [
              {
                "$ref": "#/definitions/assetRole"
              },
              {
                "const": "bg.noise-tile"
              }
            ]
          },
          "assetRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": [
          {
            "assetRole": "bg.noise-tile",
            "assetRef": "/assets/noise.webp"
          }
        ]
      },
      "videoSource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "assetRef"
        ],
        "properties": {
          "assetRole": {
            "allOf": [
              {
                "$ref": "#/definitions/assetRole"
              },
              {
                "const": "bg.video-loop"
              }
            ]
          },
          "assetRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": [
          {
            "assetRole": "bg.video-loop",
            "assetRef": "/assets/hero-tablet.mp4"
          }
        ]
      },
      "stillFallback": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetRole",
          "assetRef"
        ],
        "properties": {
          "assetRole": {
            "allOf": [
              {
                "$ref": "#/definitions/assetRole"
              },
              {
                "const": "bg.still-fallback"
              }
            ]
          },
          "assetRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": [
          {
            "assetRole": "bg.still-fallback",
            "assetRef": "/assets/tablet-pixels.webp"
          }
        ]
