  "contentFields": [
    "noiseTile",
    "videoSource",
    "stillFallback"
  ],
  "assetRoles": [
    "bg.noise-tile",
    "bg.still-fallback",
    "bg.video-loop"
  ],
  "composes": [
    "noise-overlay",
    "media-cover"
  ],
  "motion": {
    "allowedPatterns": [
      "M3",
      "M3b",
      "M21",
      "BLOG-M4"
    ],
    "reducedMotionFallback": "video-still-image"
  },
  "responsive": [
    {
      "at": ">=992",
      "target": ".bg-noise",
      "property": "opacity",
      "value": "0.5"
    },
    {
      "at": "<=991",
      "target": ".bg-noise",
      "property": "opacity",
      "value": "0.3"
    }
  ],
  "measuredFrom": [
    "CLONE_SPEC.md:129-149",
    "src/components/PageLayers.jsx:89-114",
    "specs/blog.md:31",
    "ia/ia.json:25"
  ],
  "notes": "variant is bound to the template video flag: blog-post and case-study templates have no background video (specs/blog.md section 1). The still image shows until the video fires playing, and always under prefers-reduced-motion."
